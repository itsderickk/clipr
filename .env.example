# --- Required -----------------------------------------------------------

# Postgres connection string. Neon URLs use the serverless driver; any other
# Postgres falls back to node-postgres. Run db/schema.sql against it first.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/cuts?sslmode=require"

# Session signing secret (any long random hex). REQUIRED in production —
# the app refuses to sign sessions without it. Generate with:
#   openssl rand -hex 32
JWT_SECRET="change-me"

# Public origin of the app, used for OAuth + checkout redirects.
# Falls back to the request origin when unset.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Comma-separated Whop user ids (user_...) with platform-admin powers
# (review + pay any campaign). Users can also be promoted with users.is_admin.
ADMIN_WHOP_USER_IDS=""

# --- Whop (whop.com/dashboard) ------------------------------------------

# Company API key (developer settings) with payout:transfer_funds + read scopes.
WHOP_API_KEY=
# Your company id (biz_...) — the platform balance that receives checkout
# payments and sends transfers.
WHOP_COMPANY_ID=
# OAuth app for "Sign in with Whop" (app_...). Register the redirect URI
#   <NEXT_PUBLIC_APP_URL>/api/auth/whop/callback
WHOP_CLIENT_ID=
# Only for confidential OAuth clients; public PKCE clients leave this empty.
WHOP_CLIENT_SECRET=
# Webhook signing secret for the payment.succeeded webhook pointed at
#   <NEXT_PUBLIC_APP_URL>/api/webhooks/whop
WHOP_WEBHOOK_SECRET=

# --- Optional -----------------------------------------------------------

# CoinGecko coin id charted on /token. Defaults to "solana" until $CLIPR is
# listed — then point this at the listing's id.
# TOKEN_COINGECKO_ID="solana"

# YouTube Data API v3 key. When set, the "refresh views" button on
# YouTube submissions pulls live view counts automatically.
# YOUTUBE_API_KEY=""
