# --- Required -----------------------------------------------------------

# Postgres connection string. Neon URLs use the serverless driver; any other
# Postgres falls back to node-postgres. Run db/schema.sql against it first.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/cuts?sslmode=require"

# Session signing secret (any long random hex). REQUIRED in production —
# the app refuses to sign sessions without it. Generate with:
#   openssl rand -hex 32
JWT_SECRET="change-me"

# Public origin of the app; its host goes in the wallet sign-in message.
# Falls back to the request origin when unset.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Comma-separated Solana wallet addresses with platform-admin powers
# (review + pay any campaign, settle the escrow ledger). Users can also be
# promoted with users.is_admin.
ADMIN_WALLETS=""

# --- Campaign escrow ----------------------------------------------------

# Every campaign gets its own platform-custodied wallet. Its private key is
# derived from this seed at runtime and never stored anywhere. SECRET: keep it
# only in your host's secret store, back it up offline, never commit it.
# Generate with:  openssl rand -hex 32
# Leave empty to use the manual (off-chain, admin-recorded) rail instead.
ESCROW_MASTER_SEED=
# Force a rail for new campaign wallets: "solana" or "manual".
# ESCROW_RAIL=
# Solana RPC (use a paid provider in production) and cluster name.
# SOLANA_RPC_URL="https://api.devnet.solana.com"
# SOLANA_CLUSTER="devnet"
# USDC mint. Defaults to mainnet USDC; set the devnet mint when testing.
# SOLANA_USDC_MINT="4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU"

# --- Optional -----------------------------------------------------------

# CoinGecko coin id charted on /token. Defaults to "solana" until $CLIPR is
# listed — then point this at the listing's id.
# TOKEN_COINGECKO_ID="solana"

# YouTube Data API v3 key. When set, the "refresh views" button on
# YouTube submissions pulls live view counts automatically.
# YOUTUBE_API_KEY=""
